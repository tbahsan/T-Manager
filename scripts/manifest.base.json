{
  "manifest_version": 3,
  "name": "T-Manager \u2014 YouTube Channel Manager",
  "short_name": "T-Manager",
  "version": "0.1.0",
  "author": "Tasneem Bin Ahsan (TBA) \u2014 github.com/tbahsan",
  "description": "Batch title/numbering, thumbnails, descriptions & tags + upload queue, analytics and multi-channel switching for YouTube \u2014 by TBA (github.com/tbahsan)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "T-Manager \u2014 by TBA",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "identity",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "minimum_chrome_version": "115",
  "key": ""
}